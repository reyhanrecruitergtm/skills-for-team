# Copy this file to .env and fill in your own keys
# .env is gitignored so your keys never leave your machine

# Perplexity (for the research skill)
PERPLEXITY_API_KEY=

# Apify (for web scraping actors used by sourcing-os and candidate-sourcing)
APIFY_API_KEY=

# Apollo (for contact/company enrichment)
APOLLO_API_KEY=

# Prospeo (email finder fallback)
PROSPEO_API_KEY=

# Lemlist (outbound sequences)
LEMLIST_API_KEY=

# OpenAI (used by some skill scripts — optional)
OPENAI_API_KEY=

# Anthropic (if running skill scripts that call the Claude API directly)
ANTHROPIC_API_KEY=
